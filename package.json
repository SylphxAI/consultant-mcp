{
  "name": "@sylphx/consultant-mcp",
  "version": "0.2.2",
  "description": "Beta MCP server for typed SOTA consultation, model fan-out, and judge synthesis for autonomous agents.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sylphx-consultant-mcp": "./bin/sylphx-consultant-mcp"
  },
  "files": [
    "bin",
    "bin/native",
    "dist",
    "docs",
    "examples",
    "README.md",
    "REPORT.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "bun run build:rust && ./bin/sylphx-consultant-mcp",
    "build": "bun x tsc -p tsconfig.json",
    "build:rust": "cargo build --release -p consultant-core -p consultant-mcp-server && bun scripts/stage-rust-mcp.ts",
    "assemble:multiarch": "bun scripts/assemble-multiarch-natives.ts",
    "sync:platform-versions": "bun scripts/sync-platform-versions.ts",
    "verify:multiarch-readback": "bun scripts/verify-multiarch-readback.ts",
    "check:native-packaging": "bash scripts/check-native-packaging.sh",
    "prepublishOnly": "bun run build:rust",
    "test:rust": "cargo test -p consultant-core --lib && cargo test -p consultant-mcp-server",
    "test:parity": "bun test test/parity.test.ts && cargo test -p consultant-core parity -- --nocapture",
    "test:http-transport": "bun test test/integration/http-transport.test.ts",
    "check:no-ts-http-backend": "bash scripts/check-no-ts-http-backend.sh",
    "check:no-ts-stdio-backend": "bash scripts/check-no-ts-stdio-backend.sh",
    "check:no-ts-tools-backend": "bash scripts/check-no-ts-tools-backend.sh",
    "check:ts-adapter-deleted": "bash scripts/check-ts-adapter-deletion-ready.sh",
    "test": "bun test src test",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "pack:beta": "bun run check:native-packaging",
    "clean": "rm -rf dist *.tgz target bin/native npm/*/consultant-mcp-server",
    "verify": "bun run typecheck && bun run test && bun run build && bun run test:rust && bun run test:parity && bun run test:http-transport && bun run check:ts-adapter-deleted && bun run pack:beta",
    "test:project-control": "bun test test/project-control.test.mjs",
    "groundatlas:fleet": "bun x --bun groundatlas@0.1.3 ga fleet . --out .groundatlas-pilot --require-atlas --strict --json",
    "lint:fix": "biome check --write .",
    "differential": "bash scripts/run-consultant-mcp-differential.sh"
  },
  "keywords": [
    "mcp",
    "consultant",
    "agents",
    "llm",
    "deliberation",
    "sylphx"
  ],
  "author": "Sylphx",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@sylphx/consultant-mcp-darwin-arm64": "0.2.2",
    "@sylphx/consultant-mcp-darwin-x64": "0.2.2",
    "@sylphx/consultant-mcp-linux-x64-gnu": "0.2.2",
    "@sylphx/consultant-mcp-linux-arm64-gnu": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/consultant-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SylphxAI/consultant-mcp/issues"
  },
  "homepage": "https://github.com/SylphxAI/consultant-mcp#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
